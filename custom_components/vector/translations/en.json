  "options": {
    "step": {
      "init": {
        "title": "Voice → Home Assistant",
        "description": "What Vector hears goes to this Assist agent first. When the agent does not understand, wire-pod handles the sentence as before. With an LLM agent everything is handled by Home Assistant.",
        "data": {
          "agent_id": "Assist agent",
          "respond": "Vector says the answer",
          "keep_on_vector": "Keep on Vector",
          "voice": "Answer voice",
          "tts_engine": "TTS engine",
          "tts_language": "TTS language",
          "tts_voice": "TTS voice",
          "llm_agent": "Agent for wire-pod LLM questions"
        },
        "data_description": {
          "keep_on_vector": "One phrase per line. Sentences containing one go straight to wire-pod (Vector's own clock, weather, timer, dance…) without asking Assist.",
          "voice": "wire-pod: its own TTS (e.g. Piper over Wyoming). Home Assistant TTS: the engine below, played on Vector's speaker.",
          "tts_language": "e.g. en_US for Piper (empty = engine default).",
          "tts_voice": "Optional voice name of the engine.",
          "llm_agent": "Answers what wire-pod would ask its LLM, when the switch “wire-pod LLM → Home Assistant” is on (empty = the Assist agent above)."
        }
      }
    },
    "error": {
      "tts_engine_required": "Choose a TTS engine."
    }
  },
  "config_subentries": {
    "command": {
      "initiate_flow": {
        "user": "Add command"
      },
      "entry_type": "Command",
      "step": {
        "user": {
          "title": "Voice command",
          "description": "Checked before Assist. Every match also fires the vector_command event.",
          "data": {
            "name": "Name",
            "sentences": "Sentences",
            "response": "Answer",
            "script": "Script",
            "behavior": "Vector reaction",
            "animation": "Animation group"
          },
          "data_description": {
            "sentences": "One per line, Assist syntax: [optional], (one|other), {slot} = any text, e.g. 'good night [vector]', 'play {song}'.",
            "response": "What Vector says ({slot} is replaced). Empty = silent.",
            "script": "Runs with variables text, slots, esn, device_id.",
            "behavior": "After the answer, Vector does this (like the voice command).",
            "animation": "Instead of a reaction: an animation group, e.g. GreetAfterLongTime (list: vector.list_animations)."
          }
        },
        "reconfigure": {
          "title": "Voice command",
          "description": "Checked before Assist. Every match also fires the vector_command event.",
          "data": {
            "name": "Name",
            "sentences": "Sentences",
            "response": "Answer",
            "script": "Script",
            "behavior": "Vector reaction",
            "animation": "Animation group"
          },
          "data_description": {
            "sentences": "One per line, Assist syntax: [optional], (one|other), {slot} = any text, e.g. 'good night [vector]', 'play {song}'.",
            "response": "What Vector says ({slot} is replaced). Empty = silent.",
            "script": "Runs with variables text, slots, esn, device_id.",
            "behavior": "After the answer, Vector does this (like the voice command).",
            "animation": "Instead of a reaction: an animation group, e.g. GreetAfterLongTime (list: vector.list_animations)."
          }
        }
      },
      "error": {
        "no_sentences": "Add at least one sentence.",
        "invalid_sentences": "A sentence has a syntax error (brackets, |, {slot})."
      },
      "abort": {
        "reconfigure_successful": "Command saved."
      }
    }
  }
